# Dependency lifecycle scripts are disabled so ssh2's optional `cpu-features` addon is never compiled
# with node-gyp. Native .node binaries built against system Node crash the VS Code Extension Host on
# macOS (hardened runtime / code signing), and ssh2 falls back to its JavaScript implementation anyway.
# esbuild is unaffected: its JS API resolves the platform binary from its optional dependency directly.
#
# Side effect: npm pre/post lifecycle hooks are disabled too, so scripts chain explicitly
# (see "test" in package.json) instead of relying on an implicit "pretest".
ignore-scripts=true
