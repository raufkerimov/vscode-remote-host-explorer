{
  "name": "remote-host-explorer",
  "displayName": "Remote Host Explorer",
  "description": "A fast and lightweight PhpStorm-style Remote Host manager for VS Code. Features a friendly GUI for server configuration, background upload-on-save, and direct remote file management over SFTP, FTPS, and FTP.",
  "icon": "media/icon.png",
  "version": "0.1.8",
  "license": "MIT",
  "publisher": "raufkerimov",
  "author": {
    "name": "Rauf Kerimov"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/raufkerimov/vscode-remote-host-explorer.git"
  },
  "bugs": {
    "url": "https://github.com/raufkerimov/vscode-remote-host-explorer/issues"
  },
  "homepage": "https://github.com/raufkerimov/vscode-remote-host-explorer#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "sftp",
    "ftp",
    "ftps",
    "ssh",
    "remote",
    "deployment",
    "upload"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "A project's .vscode/remote-hosts.json defines hosts to connect to and local folders to upload, so this extension only runs in trusted workspaces."
    }
  },
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "remoteHostExplorer",
          "title": "Remote Host Explorer",
          "icon": "media/remote-host-explorer.svg"
        }
      ],
      "panel": [
        {
          "id": "remoteHostExplorerTransfers",
          "title": "Transfers",
          "icon": "media/remote-host-explorer.svg"
        }
      ]
    },
    "views": {
      "remoteHostExplorer": [
        {
          "id": "remoteHostExplorer.servers",
          "name": "Remote Hosts",
          "icon": "media/remote-host-explorer.svg"
        }
      ],
      "remoteHostExplorerTransfers": [
        {
          "id": "remoteHostExplorer.transfers",
          "name": "Transfers",
          "icon": "media/remote-host-explorer.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "remoteHostExplorer.servers",
        "contents": "No remote hosts configured yet.\n[Add Server...](command:remoteHostExplorer.addServer)"
      },
      {
        "view": "remoteHostExplorer.transfers",
        "contents": "Uploads, downloads, and copies made in this window are listed here, file by file."
      }
    ],
    "commands": [
      {
        "command": "remoteHostExplorer.addServer",
        "title": "Add Server...",
        "category": "Remote Host Explorer",
        "icon": "$(add)"
      },
      {
        "command": "remoteHostExplorer.editServer",
        "title": "Edit Server...",
        "category": "Remote Host Explorer",
        "icon": "$(pencil)"
      },
      {
        "command": "remoteHostExplorer.duplicateServer",
        "title": "Duplicate Server...",
        "category": "Remote Host Explorer",
        "icon": "$(copy)"
      },
      {
        "command": "remoteHostExplorer.removeServer",
        "title": "Remove Server",
        "category": "Remote Host Explorer"
      },
      {
        "command": "remoteHostExplorer.testConnection",
        "title": "Test Connection",
        "category": "Remote Host Explorer"
      },
      {
        "command": "remoteHostExplorer.connect",
        "title": "Connect",
        "category": "Remote Host Explorer",
        "icon": "$(plug)"
      },
      {
        "command": "remoteHostExplorer.disconnect",
        "title": "Disconnect",
        "category": "Remote Host Explorer",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "remoteHostExplorer.openSshTerminal",
        "title": "Open SSH Terminal",
        "category": "Remote Host Explorer",
        "icon": "$(terminal)"
      },
      {
        "command": "remoteHostExplorer.showTransfers",
        "title": "Show Transfers",
        "category": "Remote Host Explorer"
      },
      {
        "command": "remoteHostExplorer.clearTransfers",
        "title": "Clear Transfers",
        "category": "Remote Host Explorer",
        "icon": "$(clear-all)"
      },
      {
        "command": "remoteHostExplorer.refresh",
        "title": "Refresh",
        "category": "Remote Host Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "remoteHostExplorer.openRemoteFile",
        "title": "Edit",
        "category": "Remote Host Explorer"
      },
      {
        "command": "remoteHostExplorer.uploadFile",
        "title": "Upload to Remote Host",
        "category": "Remote Host Explorer",
        "icon": "$(cloud-upload)",
        "enablement": "resourceScheme == file && (remoteHostExplorer.mappedFoldersIncomplete || resourcePath in remoteHostExplorer.mappedFolders || resourceDirname in remoteHostExplorer.mappedFolders)"
      },
      {
        "command": "remoteHostExplorer.uploadGitChanges",
        "title": "Upload Git Changes to Remote Host...",
        "category": "Remote Host Explorer",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "remoteHostExplorer.toggleAutoUpload",
        "title": "Choose Auto-Upload Servers...",
        "category": "Remote Host Explorer"
      },
      {
        "command": "remoteHostExplorer.compareWithRemote",
        "title": "Compare with Remote",
        "category": "Remote Host Explorer"
      },
      {
        "command": "remoteHostExplorer.revealInRemoteHosts",
        "title": "Reveal in Remote Hosts",
        "category": "Remote Host Explorer",
        "enablement": "resourceScheme == file && (remoteHostExplorer.mappedFoldersIncomplete || resourcePath in remoteHostExplorer.mappedFolders || resourceDirname in remoteHostExplorer.mappedFolders)"
      },
      {
        "command": "remoteHostExplorer.newFile",
        "title": "New File...",
        "category": "Remote Host Explorer",
        "icon": "$(new-file)"
      },
      {
        "command": "remoteHostExplorer.newFolder",
        "title": "New Folder...",
        "category": "Remote Host Explorer",
        "icon": "$(new-folder)"
      },
      {
        "command": "remoteHostExplorer.deleteRemoteItem",
        "title": "Delete",
        "category": "Remote Host Explorer"
      },
      {
        "command": "remoteHostExplorer.renameRemoteItem",
        "title": "Rename...",
        "category": "Remote Host Explorer"
      },
      {
        "command": "remoteHostExplorer.changePermissions",
        "title": "Change Permissions...",
        "category": "Remote Host Explorer"
      },
      {
        "command": "remoteHostExplorer.copyRemotePath",
        "title": "Copy Remote Path",
        "category": "Remote Host Explorer"
      },
      {
        "command": "remoteHostExplorer.copyFile",
        "title": "Copy",
        "category": "Remote Host Explorer"
      },
      {
        "command": "remoteHostExplorer.cutFile",
        "title": "Cut",
        "category": "Remote Host Explorer"
      },
      {
        "command": "remoteHostExplorer.pasteFile",
        "title": "Paste",
        "category": "Remote Host Explorer"
      },
      {
        "command": "remoteHostExplorer.backupFile",
        "title": "Create Backup",
        "category": "Remote Host Explorer"
      },
      {
        "command": "remoteHostExplorer.downloadRemoteItem",
        "title": "Download to Local",
        "category": "Remote Host Explorer",
        "enablement": "viewItem =~ /\\.mapped$/"
      },
      {
        "command": "remoteHostExplorer.downloadRemoteItemTo",
        "title": "Download to Folder...",
        "category": "Remote Host Explorer"
      },
      {
        "command": "remoteHostExplorer.syncWithServer",
        "title": "Sync with Remote Host...",
        "category": "Remote Host Explorer",
        "enablement": "resourceScheme == file && (remoteHostExplorer.mappedFoldersIncomplete || resourcePath in remoteHostExplorer.mappedFolders || resourceDirname in remoteHostExplorer.mappedFolders)"
      },
      {
        "command": "remoteHostExplorer.syncRemoteFolder",
        "title": "Sync with Local Folder...",
        "category": "Remote Host Explorer",
        "enablement": "viewItem =~ /\\.mapped$/"
      },
      {
        "command": "remoteHostExplorer.syncServer",
        "title": "Sync with Server...",
        "category": "Remote Host Explorer",
        "icon": "$(sync)"
      },
      {
        "command": "remoteHostExplorer.compareRemoteItem",
        "title": "Compare with Local",
        "category": "Remote Host Explorer",
        "enablement": "viewItem =~ /\\.mapped$/"
      }
    ],
    "keybindings": [
      {
        "command": "remoteHostExplorer.copyFile",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == remoteHostExplorer.servers && !inputFocus"
      },
      {
        "command": "remoteHostExplorer.cutFile",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "focusedView == remoteHostExplorer.servers && !inputFocus"
      },
      {
        "command": "remoteHostExplorer.pasteFile",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "focusedView == remoteHostExplorer.servers && !inputFocus"
      },
      {
        "command": "remoteHostExplorer.deleteRemoteItem",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == remoteHostExplorer.servers && !inputFocus"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "remoteHostExplorer.openRemoteFile",
          "when": "false"
        },
        {
          "command": "remoteHostExplorer.newFile",
          "when": "false"
        },
        {
          "command": "remoteHostExplorer.newFolder",
          "when": "false"
        },
        {
          "command": "remoteHostExplorer.deleteRemoteItem",
          "when": "false"
        },
        {
          "command": "remoteHostExplorer.renameRemoteItem",
          "when": "false"
        },
        {
          "command": "remoteHostExplorer.copyRemotePath",
          "when": "false"
        },
        {
          "command": "remoteHostExplorer.copyFile",
          "when": "false"
        },
        {
          "command": "remoteHostExplorer.cutFile",
          "when": "false"
        },
        {
          "command": "remoteHostExplorer.pasteFile",
          "when": "false"
        },
        {
          "command": "remoteHostExplorer.backupFile",
          "when": "false"
        },
        {
          "command": "remoteHostExplorer.downloadRemoteItem",
          "when": "false"
        },
        {
          "command": "remoteHostExplorer.downloadRemoteItemTo",
          "when": "false"
        },
        {
          "command": "remoteHostExplorer.compareRemoteItem",
          "when": "false"
        },
        {
          "command": "remoteHostExplorer.uploadFile",
          "when": "false"
        },
        {
          "command": "remoteHostExplorer.compareWithRemote",
          "when": "remoteHostExplorer.activeEditorMapped"
        },
        {
          "command": "remoteHostExplorer.syncWithServer",
          "when": "false"
        },
        {
          "command": "remoteHostExplorer.syncRemoteFolder",
          "when": "false"
        },
        {
          "command": "remoteHostExplorer.uploadGitChanges",
          "when": "remoteHostExplorer.hasMappings"
        },
        {
          "command": "remoteHostExplorer.toggleAutoUpload",
          "when": "remoteHostExplorer.activeEditorMapped"
        },
        {
          "command": "remoteHostExplorer.revealInRemoteHosts",
          "when": "false"
        },
        {
          "command": "remoteHostExplorer.changePermissions",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "remoteHostExplorer.addServer",
          "when": "view == remoteHostExplorer.servers",
          "group": "navigation"
        },
        {
          "command": "remoteHostExplorer.refresh",
          "when": "view == remoteHostExplorer.servers",
          "group": "navigation"
        },
        {
          "command": "remoteHostExplorer.clearTransfers",
          "when": "view == remoteHostExplorer.transfers",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "remoteHostExplorer.connect",
          "when": "view == remoteHostExplorer.servers && viewItem =~ /^remoteHostExplorer\\.server\\.disconnected\\./",
          "group": "inline"
        },
        {
          "command": "remoteHostExplorer.disconnect",
          "when": "view == remoteHostExplorer.servers && viewItem =~ /^remoteHostExplorer\\.server\\.connected\\./",
          "group": "inline"
        },
        {
          "command": "remoteHostExplorer.editServer",
          "when": "view == remoteHostExplorer.servers && viewItem =~ /^remoteHostExplorer\\.server\\./",
          "group": "inline"
        },
        {
          "command": "remoteHostExplorer.connect",
          "when": "view == remoteHostExplorer.servers && viewItem =~ /^remoteHostExplorer\\.server\\.disconnected\\./",
          "group": "1_connection@1"
        },
        {
          "command": "remoteHostExplorer.disconnect",
          "when": "view == remoteHostExplorer.servers && viewItem =~ /^remoteHostExplorer\\.server\\.connected\\./",
          "group": "1_connection@2"
        },
        {
          "command": "remoteHostExplorer.testConnection",
          "when": "view == remoteHostExplorer.servers && viewItem =~ /^remoteHostExplorer\\.server\\./",
          "group": "1_connection@3"
        },
        {
          "command": "remoteHostExplorer.openSshTerminal",
          "when": "view == remoteHostExplorer.servers && viewItem =~ /^remoteHostExplorer\\.server\\.[a-z]+\\.sftp$/",
          "group": "1_connection@4"
        },
        {
          "command": "remoteHostExplorer.editServer",
          "when": "view == remoteHostExplorer.servers && viewItem =~ /^remoteHostExplorer\\.server\\./",
          "group": "2_modification@1"
        },
        {
          "command": "remoteHostExplorer.duplicateServer",
          "when": "view == remoteHostExplorer.servers && viewItem =~ /^remoteHostExplorer\\.server\\./",
          "group": "2_modification@2"
        },
        {
          "command": "remoteHostExplorer.removeServer",
          "when": "view == remoteHostExplorer.servers && viewItem =~ /^remoteHostExplorer\\.server\\./",
          "group": "2_modification@3"
        },
        {
          "command": "remoteHostExplorer.openRemoteFile",
          "when": "view == remoteHostExplorer.servers && viewItem =~ /^remoteHostExplorer\\.file\\./",
          "group": "1_open@1"
        },
        {
          "command": "remoteHostExplorer.newFile",
          "when": "view == remoteHostExplorer.servers && !listMultiSelection && (viewItem =~ /^remoteHostExplorer\\.directory\\./ || viewItem =~ /^remoteHostExplorer\\.server\\.connected\\./)",
          "group": "1_open@2"
        },
        {
          "command": "remoteHostExplorer.newFolder",
          "when": "view == remoteHostExplorer.servers && !listMultiSelection && (viewItem =~ /^remoteHostExplorer\\.directory\\./ || viewItem =~ /^remoteHostExplorer\\.server\\.connected\\./)",
          "group": "1_open@3"
        },
        {
          "command": "remoteHostExplorer.downloadRemoteItem",
          "when": "view == remoteHostExplorer.servers && viewItem =~ /^remoteHostExplorer\\.(file|directory)\\./",
          "group": "2_transfer@1"
        },
        {
          "command": "remoteHostExplorer.downloadRemoteItemTo",
          "when": "view == remoteHostExplorer.servers && viewItem =~ /^remoteHostExplorer\\.(file|directory)\\./",
          "group": "2_transfer@2"
        },
        {
          "command": "remoteHostExplorer.compareRemoteItem",
          "when": "view == remoteHostExplorer.servers && !listMultiSelection && viewItem =~ /^remoteHostExplorer\\.file\\./",
          "group": "2_transfer@3"
        },
        {
          "command": "remoteHostExplorer.backupFile",
          "when": "view == remoteHostExplorer.servers && viewItem =~ /^remoteHostExplorer\\.file\\./",
          "group": "2_transfer@4"
        },
        {
          "command": "remoteHostExplorer.cutFile",
          "when": "view == remoteHostExplorer.servers && viewItem =~ /^remoteHostExplorer\\.(file|directory)\\./",
          "group": "3_ops@1"
        },
        {
          "command": "remoteHostExplorer.copyFile",
          "when": "view == remoteHostExplorer.servers && viewItem =~ /^remoteHostExplorer\\.(file|directory)\\./",
          "group": "3_ops@2"
        },
        {
          "command": "remoteHostExplorer.pasteFile",
          "when": "view == remoteHostExplorer.servers && !listMultiSelection && (viewItem =~ /^remoteHostExplorer\\.directory\\./ || viewItem =~ /^remoteHostExplorer\\.server\\.connected\\./)",
          "group": "3_ops@3"
        },
        {
          "command": "remoteHostExplorer.copyRemotePath",
          "when": "view == remoteHostExplorer.servers && viewItem =~ /^remoteHostExplorer\\.(file|directory)\\./",
          "group": "3_ops@4"
        },
        {
          "command": "remoteHostExplorer.renameRemoteItem",
          "when": "view == remoteHostExplorer.servers && !listMultiSelection && viewItem =~ /^remoteHostExplorer\\.(file|directory)\\./",
          "group": "3_ops@5"
        },
        {
          "command": "remoteHostExplorer.deleteRemoteItem",
          "when": "view == remoteHostExplorer.servers && viewItem =~ /^remoteHostExplorer\\.(file|directory)\\./",
          "group": "3_ops@6"
        },
        {
          "command": "remoteHostExplorer.openSshTerminal",
          "when": "view == remoteHostExplorer.servers && !listMultiSelection && viewItem =~ /^remoteHostExplorer\\.directory\\.sftp\\./",
          "group": "4_terminal@1"
        },
        {
          "command": "remoteHostExplorer.syncRemoteFolder",
          "when": "view == remoteHostExplorer.servers && !listMultiSelection && viewItem =~ /^remoteHostExplorer\\.directory\\./",
          "group": "2_transfer@5"
        },
        {
          "command": "remoteHostExplorer.syncServer",
          "when": "view == remoteHostExplorer.servers && viewItem =~ /^remoteHostExplorer\\.server\\./",
          "group": "1_connection@5"
        },
        {
          "command": "remoteHostExplorer.changePermissions",
          "when": "view == remoteHostExplorer.servers && viewItem =~ /^remoteHostExplorer\\.(file|directory)\\./",
          "group": "3_ops@7"
        }
      ],
      "explorer/context": [
        {
          "command": "remoteHostExplorer.uploadFile",
          "when": "remoteHostExplorer.hasMappings && resourceScheme == file",
          "group": "remoteHostExplorer"
        },
        {
          "command": "remoteHostExplorer.compareWithRemote",
          "when": "remoteHostExplorer.hasMappings && !explorerResourceIsFolder",
          "group": "remoteHostExplorer"
        },
        {
          "command": "remoteHostExplorer.syncWithServer",
          "when": "remoteHostExplorer.hasMappings && resourceScheme == file && explorerResourceIsFolder",
          "group": "remoteHostExplorer"
        },
        {
          "command": "remoteHostExplorer.revealInRemoteHosts",
          "when": "remoteHostExplorer.hasMappings && resourceScheme == file",
          "group": "remoteHostExplorer"
        }
      ],
      "editor/title/context": [
        {
          "command": "remoteHostExplorer.compareWithRemote",
          "when": "remoteHostExplorer.activeEditorMapped",
          "group": "remoteHostExplorer"
        },
        {
          "command": "remoteHostExplorer.revealInRemoteHosts",
          "when": "remoteHostExplorer.hasMappings && resourceScheme == file",
          "group": "remoteHostExplorer"
        }
      ],
      "scm/title": [
        {
          "command": "remoteHostExplorer.uploadGitChanges",
          "when": "scmProvider == git && remoteHostExplorer.hasMappings",
          "group": "remoteHostExplorer"
        }
      ]
    },
    "configuration": {
      "title": "Remote Host Explorer",
      "properties": {
        "remoteHostExplorer.servers": {
          "type": "array",
          "default": [],
          "description": "Servers available in all projects. Set this in user settings; servers for a single project are saved in that project's .vscode/remote-hosts.json. Passwords and key passphrases are never stored here; they live in VS Code SecretStorage.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "protocol",
              "host",
              "remoteRoot"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable unique identifier used to key stored secrets."
              },
              "name": {
                "type": "string",
                "description": "Display name shown in the Remote Hosts view."
              },
              "protocol": {
                "type": "string",
                "enum": [
                  "sftp",
                  "ftps",
                  "ftp"
                ],
                "enumDescriptions": [
                  "SFTP over SSH (default port 22). Supports password or private key authentication.",
                  "FTP over TLS (default port 21). Uses explicit TLS (AUTH TLS), or implicit TLS when the port is 990. Password authentication; the server certificate is verified.",
                  "Plain FTP (default port 21). Password and file contents are sent unencrypted."
                ],
                "default": "sftp",
                "description": "Remote transport."
              },
              "host": {
                "type": "string"
              },
              "port": {
                "type": "number",
                "minimum": 1,
                "maximum": 65535,
                "default": 22
              },
              "username": {
                "type": "string"
              },
              "privateKeyPath": {
                "type": "string",
                "description": "Path to an SSH private key. Setting this selects key authentication. A leading ~ means your home folder, e.g. ~/.ssh/id_rsa."
              },
              "useSshAgent": {
                "type": "boolean",
                "default": false,
                "description": "SFTP only. Authenticate with the keys loaded in your running SSH agent (ssh-agent, or the OpenSSH Authentication Agent on Windows)."
              },
              "remoteRoot": {
                "type": "string",
                "description": "Root path on the remote server shown in the Remote Hosts view."
              },
              "mappings": {
                "type": "array",
                "description": "Local folders linked to folders on the server, used for uploads, downloads, Compare, and auto-upload. When mapped folders are nested, the deepest one wins.",
                "items": {
                  "type": "object",
                  "required": [
                    "localPath"
                  ],
                  "properties": {
                    "localPath": {
                      "type": "string",
                      "description": "Folder on this computer."
                    },
                    "remotePath": {
                      "type": "string",
                      "description": "Server folder that localPath corresponds to. Defaults to remoteRoot. Set it to browse a larger folder while mapping only part of it, for example a whole WordPress install with only the theme mapped."
                    }
                  }
                }
              },
              "localPath": {
                "type": "string",
                "description": "Single local folder mapped to remoteMappedPath (or remoteRoot), as saved by earlier versions. Prefer mappings; both are honoured."
              },
              "remoteMappedPath": {
                "type": "string",
                "description": "Server folder that localPath corresponds to. Defaults to remoteRoot. Prefer mappings."
              },
              "autoUpload": {
                "type": "boolean",
                "default": false,
                "description": "Automatically upload files inside a mapped local folder on save."
              },
              "production": {
                "type": "boolean",
                "default": false,
                "description": "A live server: uploads, deletes, moves, renames, and other changes to its files ask for confirmation first, and it is shown in red."
              },
              "ignoreGlobs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [
                  "**/.git/**",
                  "**/node_modules/**",
                  "**/.vscode/**",
                  "**/.env",
                  "**/.env.*",
                  "**/.ssh/**",
                  "**/*.pem",
                  "**/*.key"
                ],
                "description": "Paths relative to the mapped local folder that are skipped by auto-upload and recursive uploads/downloads. Supports *, ?, and **. When omitted, the defaults apply; set [] to ignore nothing."
              },
              "useRsyncForUpload": {
                "type": "boolean",
                "default": false,
                "description": "Upload files via the rsync binary over ssh instead of SFTP put (requires local rsync/ssh binaries)."
              },
              "rsyncOptions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Extra flags passed to the rsync binary when useRsyncForUpload is enabled."
              }
            }
          }
        },
        "remoteHostViewer.servers": {
          "type": "array",
          "default": [],
          "deprecationMessage": "Renamed to remoteHostExplorer.servers. Remote Host Explorer moves these servers automatically."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": ".vscode/remote-hosts.json",
        "url": "./media/remote-hosts.schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
